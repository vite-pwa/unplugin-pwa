{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker", "WebWorker.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@unplugin-pwa/inspector/package.json": [
        "./packages/inspector/package.json"
      ],
      "@unplugin-pwa/core": [
        "./packages/core/types.ts"
      ],
      "@unplugin-pwa/core/types": [
        "./packages/core/types/index.d.ts"
      ],
      "@unplugin-pwa/core/client": [
        "./packages/core/client.d.ts"
      ],
      "@unplugin-pwa/core/info": [
        "./packages/core/info.d.ts"
      ],
      "@unplugin-pwa/core/preact": [
        "./packages/core/preact.d.ts"
      ],
      "@unplugin-pwa/core/pwa-assets": [
        "./packages/core/pwa-assets.d.ts"
      ],
      "@unplugin-pwa/core/react": [
        "./packages/core/react.d.ts"
      ],
      "@unplugin-pwa/core/react-legacy": [
        "./packages/core/react-legacy.d.ts"
      ],
      "@unplugin-pwa/core/solid": [
        "./packages/core/solid.d.ts"
      ],
      "@unplugin-pwa/core/svelte": [
        "./packages/core/svelte.d.ts"
      ],
      "@unplugin-pwa/core/vanillajs": [
        "./packages/core/vanillajs.d.ts"
      ],
      "@unplugin-pwa/core/vue": [
        "./packages/core/vue.d.ts"
      ],
      "@unplugin-pwa/core/*": [
        "./packages/core/*.ts"
      ],
      "@unplugin-pwa/vite": [
        "./packages/vite/src/index.ts"
      ],
      "@unplugin-pwa/vite/devtools": [
        "./packages/vite/devtools.d.ts"
      ],
      "@unplugin-pwa/vite/hmr-entry-point": [
        "./packages/vite/hmr-entry-point.d.ts"
      ],
      "@unplugin-pwa/vite/*": [
        "./packages/vite/src/*.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
