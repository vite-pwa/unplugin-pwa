{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker", "WebWorker.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@vite-pwa/unplugin-pwa-types": [
        "./packages/types/types/index.d.ts"
      ],
      "@vite-pwa/unplugin-pwa-types/*": [
        "./packages/types/*.ts"
      ],
      "@vite-pwa/unplugin-pwa-core/*": [
        "./packages/core/*.ts"
      ],
      "@vite-pwa/unplugin-pwa-vite": [
        "./packages/vite/src/index.ts"
      ],
      "@vite-pwa/unplugin-pwa-vite/devtools": [
        "./packages/vite/devtools.d.ts"
      ],
      "@vite-pwa/unplugin-pwa-vite/hmr-entry-point": [
        "./packages/vite/hmr-entry-point.d.ts"
      ],
      "@vite-pwa/unplugin-pwa-vite/*": [
        "./packages/vite/src/*.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
