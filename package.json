{
  "name": "unplugin-pwa",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Vite PWA Ecosystem for modern web bundlers and meta-frameworks.",
  "author": "Vite PWA's Team",
  "maintainers": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/unplugin-pwa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/unplugin-pwa.git"
  },
  "bugs": "https://github.com/vite-pwa/unplugin-pwa/issues",
  "keywords": [
    "unplugin",
    "pwa",
    "workbox",
    "service-worker",
    "web-manifest",
    "vite",
    "webpack",
    "rspack",
    "rolldown",
    "plugin",
    "ecosystem",
    "pwa ecosystem",
    "build"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm -r --filter=\"./packages/**/\" run test",
    "test:ci": "pnpm -r --filter=\"./packages/**/\" run test:ci",
    "test:typecheck": "pnpm -r --filter=\"./packages/**/\" run test:typecheck",
    "build": "pnpm -r --filter=\"./packages/**/\" run build",
    "update:deps": "taze -I",
    "update:workflows": "pnpm dlx actions-up -y",
    "update:workflows:dry": "pnpm dlx actions-up --dry-run",
    "test:typescript": "pnpm -C examples/vanilla-ts-no-ip run test",
    "test:vite-ecosystem-ci": "nr test:typescript"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@arethetypeswrong/core": "catalog:utils",
    "@playwright/test": "catalog:utils",
    "@types/node": "catalog:types",
    "@types/trusted-types": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "playwright-core": "catalog:utils",
    "publint": "catalog:utils",
    "taze": "catalog:utils",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "unrun": "catalog:utils",
    "verkit": "catalog:utils",
    "vitest": "catalog:test",
    "why-is-node-running": "catalog:utils"
  }
}
