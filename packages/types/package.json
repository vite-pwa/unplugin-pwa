{
  "name": "@vite-pwa/unplugin-pwa-types",
  "type": "module",
  "version": "0.0.0",
  "description": "TypeScript definitions for unplugin-pwa virtual modules",
  "author": "Vite PWA's Team",
  "maintainers": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/unplugin-pwa/packages/types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/unplugin-pwa.git"
  },
  "bugs": "https://github.com/vite-pwa/unplugin-pwa/issues",
  "keywords": [
    "react",
    "pwa",
    "vue",
    "preact",
    "svelte",
    "sveltekit",
    "solidjs"
  ],
  "sideEffects": false,
  "types": "./types/index.d.ts",
  "exports": {
