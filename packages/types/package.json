      "types": "./types/index.d.ts"
    },
    "./preact": {
      "types": "./preact.d.ts"
    },
    "./react": {
      "types": "./react.d.ts"
    },
    "./react-legacy": {
      "types": "./react-legacy.d.ts"
    },
    "./solid": {
      "types": "./solid.d.ts"
    },
    "./svelte": {
      "types": "./svelte.d.ts"
    },
    "./vanillajs": {
      "types": "./vanillajs.d.ts"
    },
    "./vue": {
      "types": "./vue.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./info": {
      "types": "./info.d.ts"
    },
    "./pwa-assets": {
      "types": "./pwa-assets.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.d.ts",
    "types"
  ],
  "scripts": {
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/trusted-types": "catalog:types"
  },
  "devDependencies": {
    "@types/react": "catalog:react",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "preact": "catalog:preact",
    "react": "catalog:react",
    "solid-js": "catalog:solid-js",
    "svelte": "catalog:svelte",
    "vite": "catalog:vite",
    "vue": "catalog:vue"
  }
