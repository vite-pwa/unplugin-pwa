{
  "name": "@unplugin-pwa/types",
  "type": "module",
  "version": "0.0.1",
  "description": "TypeDoc JSON metadata for the unplugin-pwa packages, published for the Vite PWA docs site to render its API reference.",
  "author": "Vite PWA's Team",
  "maintainers": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/unplugin-pwa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/unplugin-pwa.git",
    "directory": "packages/types"
  },
  "bugs": "https://github.com/vite-pwa/unplugin-pwa/issues",
  "keywords": [
    "react",
    "pwa",
    "vue",
    "preact",
    "svelte",
    "sveltekit",
    "solidjs"
  ],
  "sideEffects": false,
  "exports": {
    "./unplugin-pwa/core": "./api/core.json",
    "./unplugin-pwa/vite": "./api/vite.json",
    "./package.json": "./package.json"
  },
  "files": [
    "api"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "prepare-names": "node prepare-names.mts",
    "build": "node gen.mts",
    "docs:api": "node gen.mts",
    "prepack": "pnpm run docs:api"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "catalog:utils",
    "@unplugin-pwa/core": "workspace:*",
    "@unplugin-pwa/vite": "workspace:*",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "tinyglobby": "catalog:utils",
    "typedoc": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
